APP_NAME="Everything AI Tutor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

# --- Database: PostgreSQL (system of record) ---
# docker-compose overrides these with the postgres service values.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aitutor
DB_USERNAME=aitutor
DB_PASSWORD=aitutor

# --- Redis (cache / queue / token counters) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Sanctum / SPA ---
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DRIVER=database
FRONTEND_URL=http://localhost:5173

# --- AI service (Python FastAPI; owns all LLM/RAG work) ---
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_KEY=dev-internal-key

# --- Google Gemini (legacy direct client; only used if AI service is bypassed) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MOCK=true

# --- Billing / subscriptions ---
# 'manual' activates instantly (dev / offline school deals). End users pick
# Razorpay (UPI/cards, INR) or PayPal (international, USD) at checkout.
# Webhooks: /api/billing/webhook/razorpay  and  /api/billing/webhook/paypal
BILLING_PROVIDER=manual
BILLING_TRIAL_DAYS=0
BILLING_INR_PER_USD=83
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# Unit economics for the admin margin-guard (worst-case ₹/credit and the COGS
# ceiling used to derive cost-safe plan caps). Defaults keep every paid plan
# at ~70% worst-case margin.
BILLING_COST_PER_CREDIT=0.15
BILLING_COGS_CEILING=0.30
