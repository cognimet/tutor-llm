APP_NAME="Everything AI Tutor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

# --- Database: SQLite (zero-config) ---
DB_CONNECTION=sqlite
# DB_DATABASE is resolved to database/database.sqlite by default

# --- Sanctum / SPA ---
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DRIVER=database
FRONTEND_URL=http://localhost:5173

# --- Python AI service (FastAPI) ---
# All LLM calls go through this service when set (architecture doc).
# Empty = legacy direct-Gemini fallback inside Laravel.
AI_SERVICE_URL=http://localhost:8001

# --- Google Gemini (used by the AI service, and by the legacy fallback) ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
# Set GEMINI_MOCK=true to run the full flow with no API calls
GEMINI_MOCK=false
