# Root env for docker-compose. Copy to .env and fill in.
#
# ── LLM provider (pick ONE, or none for mock mode) ──────────────────────
# AI_PROVIDER: auto | gemini | google | openai | anthropic
#   "auto" uses the first provider below that has a key set.
#   "google" = Gemini 2.5 Flash via the google-genai SDK (text + vision) — the
#              env switch for "use Gemini for everything" (see block below).
AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Use Gemini 2.5 Flash for the whole app (set AI_PROVIDER=google) ────────
# Simplest: paste a Gemini API key into GEMINI_API_KEY above (works in Docker,
# no token expiry); the google-genai SDK picks it up and vision uses Gemini too.
#   AI_PROVIDER=google
#   GEMINI_API_KEY=...                    # from aistudio.google.com/apikey
#   GEMINI_VISION_MODEL=gemini-2.5-flash  # model used to read images
# To use ADC / Vertex instead of an API key, uncomment the gcloud volume in
# docker-compose.yml and set GOOGLE_APPLICATION_CREDENTIALS + GOOGLE_CLOUD_PROJECT
# (+ GOOGLE_GENAI_USE_VERTEXAI=true and GOOGLE_CLOUD_LOCATION for Vertex AI).
# OpenAI-compatible gateways (e.g. OpenRouter) work via the openai provider:
#   OPENAI_API_KEY=sk-or-...           (your OpenRouter key)
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Leave AI_MOCK=true to run the whole stack with no key at all.
AI_MOCK=true

# ── Model routing ────────────────────────────────────────────────────────
# SINGLE-MODEL SWITCH: set AI_MODEL and it is used for EVERYTHING
# (the three per-action routes below are ignored).
AI_MODEL=
# Per-action routing (used only when AI_MODEL is empty). Recommended free
# stack via OpenRouter:
#   AI_MODEL_CHAT=google/gemma-4-31b:free            (teaching, multilingual)
#   AI_MODEL_STRUCTURED=openai/gpt-oss-120b:free     (assessments/gaps/plans JSON)
#   AI_MODEL_GRADE=openai/gpt-oss-20b:free           (cheap fast grading)
AI_MODEL_CHAT=
AI_MODEL_STRUCTURED=
AI_MODEL_GRADE=
# Vision model (OpenRouter, OpenAI-compatible) for reading uploaded diagrams,
# figures and handwriting. Needs OPENAI_API_KEY (OpenRouter). Else: tesseract OCR.
AI_MODEL_VISION=nvidia/nemotron-nano-12b-v2-vl:free

# Postgres password (system of record).
DB_PASSWORD=aitutor

# Neo4j knowledge graph (GraphRAG "AI mind") password.
NEO4J_PASSWORD=tutopass

# Shared secret between Laravel and the Python AI service.
INTERNAL_API_KEY=dev-internal-key
