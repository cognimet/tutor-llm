# Production frontend: build the static bundle, then serve it with nginx.
#
# This replaces the dev-server-in-production setup (the plain Dockerfile runs
# `npm run dev`, whose on-the-fly dependency optimizer breaks on any dependency
# change and can serve two copies of React → "Invalid hook call / blank page").
# A built bundle has none of that: hashed, immutable assets and a static server.

# --- build stage ---------------------------------------------------------
FROM node:20-alpine AS build
WORKDIR /app

# Install from the lockfile for a reproducible tree (falls back to install if
# the lockfile is absent).
COPY package.json package-lock.json* ./
RUN npm ci || npm install

COPY . .
RUN npm run build

# --- serve stage ---------------------------------------------------------
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
