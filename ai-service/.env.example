# AI service config. Copy to .env for local non-docker runs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MOCK=true

# Vector DB for RAG (optional in MVP). Leave blank to run ungrounded.
QDRANT_URL=
QDRANT_COLLECTION=curriculum
QDRANT_DOC_COLLECTION=documents
QDRANT_EVENT_COLLECTION=events
RAG_TOP_K=5

# Neo4j knowledge graph (GraphRAG "AI mind"). Leave NEO4J_URI blank to run
# without the graph (the tutor still works; grounding falls back to plain RAG).
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=tutopass

# Shared secret Laravel must send as `Authorization: Bearer <key>`.
INTERNAL_API_KEY=

# Multimodal diagram ingest (OpenCV → PaddleOCR → Gemini → UVSS).
# Dockerized PaddleOCR microservice for label OCR. Leave blank to disable OCR
# (the pipeline still runs; labels come from the VLM). In docker-compose this
# defaults to http://paddleocr:8002.
PADDLE_OCR_URL=
PADDLE_OCR_LANG=en
# Max diagrams parsed per uploaded note, and the confidence floor below which
# the UVSS schema is dropped in favour of an image-only (still retrievable) node.
DIAGRAM_MAX_REGIONS=6
# Low on purpose: hand-drawn figures rarely score high, and the viewer can
# always fall back to the student's real drawing, so we keep the rebuilt sketch.
DIAGRAM_MIN_CONFIDENCE=0.4
# Diagram Isolation upgrade: trace each accepted diagram's true polygon (VLM
# segmentation mask → OpenCV heuristic fallback), render the transparent
# `…_isolated.png` asset, and OCR the page-minus-diagram remainder into the
# anchor text linked to the diagram. Set false to keep rectangular crops only.
DIAGRAM_ISOLATION_ENABLED=true
# Idealised render: after isolation, use a Gemini IMAGE model to redraw the
# diagram as a clean, labelled textbook illustration (shown by default in the
# Visual Context Viewer). This is a generative image call — extra credits per
# diagram — so set false to skip it and use the UVSS vector sketch only.
DIAGRAM_ILLUSTRATE_ENABLED=true
# Interactive UVSS reconstruction. OFF by default: it needs a large (16k+ token)
# structured call per diagram. Illustration-only mode (this off) uses just a
# cheap classify/label call + the image render, saving tokens. Set true to also
# build the interactive stroke-by-stroke sketch.
DIAGRAM_RECONSTRUCT_ENABLED=false
# The Gemini image model used for the idealised render. Override if Google
# renames it (e.g. a preview id like gemini-2.5-flash-image-preview).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
