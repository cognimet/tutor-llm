# AI service config. Copy to .env for local non-docker runs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MOCK=true

# Vector DB for RAG (optional in MVP). Leave blank to run ungrounded.
QDRANT_URL=
QDRANT_COLLECTION=curriculum
QDRANT_DOC_COLLECTION=documents
QDRANT_EVENT_COLLECTION=events
RAG_TOP_K=5

# Neo4j knowledge graph (GraphRAG "AI mind"). Leave NEO4J_URI blank to run
# without the graph (the tutor still works; grounding falls back to plain RAG).
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=tutopass

# Shared secret Laravel must send as `Authorization: Bearer <key>`.
INTERNAL_API_KEY=
